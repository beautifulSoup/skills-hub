# ============================================================
# skills-hub .env 示例
# ============================================================
# 默认未注释段对应"内置 mysql + 内置 redis + 本地存储"形态（dev / 开源 POC）
# 切 prod / 外部中间件：按各区块"prod 切换" / "形态 A 外部"注释提示，注释当前段、取消注释目标段
# ============================================================

# === Django ===
DJANGO_SECRET_KEY=dev-only-secret-please-regenerate-for-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# prod 切换：DEBUG=False；ALLOWED_HOSTS 填实际域名；SECRET_KEY 用 `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` 生成

# === BASE_URL（邮件中绝对 URL 的前缀，T8 R-7 审核结果邮件使用）===
BASE_URL=http://localhost:8000
# prod 切换：BASE_URL=https://skills-hub.example.corp（必须填实际域名，否则邮件链接对外不可访问）

# === Database ===
# --- 形态 A：外部 MySQL（推荐生产）---
# DB_HOST=your-rds-endpoint.aliyuncs.com
# DB_PORT=3306
# DB_NAME=skillshub
# DB_USER=skillshub
# DB_PASSWORD=...
#
# --- 形态 B：内置 MySQL（docker compose --profile bundled-mysql up）---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=skillshub
DB_USER=skillshub
DB_PASSWORD=skillshub-dev
DB_ROOT_PASSWORD=root-dev    # 仅 bundled-mysql profile 用，外部 RDS 形态可删

# === Redis / Celery ===
# Redis 仅作 Celery 的 broker + result backend（异步任务），不存持久数据。
# --- 形态 A：外部 Redis（已有 Redis 集群时；不加 --profile bundled-redis）---
# REDIS_URL=redis://your-redis-host:6379/0
# CELERY_BROKER_URL=redis://your-redis-host:6379/1
# CELERY_RESULT_BACKEND=redis://your-redis-host:6379/2
#
# --- 形态 B：内置 Redis（docker compose --profile bundled-redis up）---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === SMTP（占位，T11 用）===
# 端口语义：465=隐式 SSL，587=STARTTLS（settings 按端口自动选，二选一）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# DEBUG=True 时默认用 console backend（只打印不发信）。
# 本地想真发信联调，置 True 强制走 SMTP（生产 DEBUG=False 时本项无影响）。
FORCE_SMTP=False

# === Storage（T3 实现，T1 仅占位）===
# dev / test 默认本地盘
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/data/storage

# prod 切阿里云 OSS：注释上面、取消下面注释、填入真实值
# STORAGE_BACKEND=aliyun_oss
# STORAGE_OSS_ACCESS_KEY_ID=
# STORAGE_OSS_ACCESS_KEY_SECRET=
# STORAGE_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# STORAGE_OSS_BUCKET=

# === Auth（T2 用）===
INITIAL_ADMIN_EMAILS=
EMAIL_DOMAIN_WHITELIST=

# === Demo 路由开关 ===
# T1 demo /demo* 路由是否暴露；prod 应设为 False
EXPOSE_DEMO=True
